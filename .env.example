# URL pública do site (usada em canonical, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://diamondcvisual.com.br

# Número do WhatsApp no formato internacional, só dígitos
NEXT_PUBLIC_WHATSAPP_NUMBER=5511913553258

# Container único do Google Tag Manager (deixe vazio para desativar)
NEXT_PUBLIC_GTM_ID=

# Envio do formulário por e-mail (Resend) [confirmar provedor]
RESEND_API_KEY=
LEAD_TO_EMAIL=contato@diamondcvisual.com.br
# Remetente verificado no Resend
LEAD_FROM_EMAIL=Diamond Site <site@diamondcvisual.com.br>

# Força os selos [confirmar] em produção (1 = mostrar)
NEXT_PUBLIC_SHOW_CONFIRM=
